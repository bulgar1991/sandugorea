# /etc/sandugorea/backup.env - settings for the nightly backup (sandugorea-backup).
# REMOTE must be an rclone *crypt* remote, so photos are encrypted before they leave the server.
# Set it up with the commands in deploy/BACKUP.md.
REMOTE=sgbackup:

# How long database snapshots and deleted photos are kept off-site.
KEEP_DAYS=30

# Database snapshots kept on the server itself.
LOCAL_KEEP=7
