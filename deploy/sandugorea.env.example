# Copy to /etc/sandugorea/sandugorea.env  (sudo chmod 600, owned by root)
# Double underscore = nested setting (Admin:Username -> Admin__Username).

# First admin account - only used when no admin exists yet. Remove the password after
# the first sign-in; change it later from Admin > Security.
Admin__Username=sandu
Admin__Password=CHANGE-ME-to-12+chars-Aa1!

# Public address (used in emails to customers)
Site__BaseUrl=https://sandugorea.com

# Email. Leave Email__SmtpHost empty to only write emails to /var/lib/sandugorea/outbox.
Email__SmtpHost=smtp.example.com
Email__SmtpPort=587
Email__SmtpUser=hello@sandugorea.com
Email__SmtpPassword=
Email__FromAddress=hello@sandugorea.com
Email__FromName=Sandugorea Photography
Email__OwnerAddress=hello@sandugorea.com
