# /etc/sandugorea/sandugorea.env  (chmod 600, owned by root) - setup-server.sh creates it from this file.
# Double underscore = nested setting (Admin:Username -> Admin__Username).

# First admin account - only used when no admin exists yet.
# 12+ characters with upper, lower, a digit and a symbol.
# REMOVE the password line after your first sign-in (change it later in Admin > Security).
Admin__Username=sandu
Admin__Password=

# Public address (used in emails to customers)
Site__BaseUrl=https://sandugorea.ch

# Email. Leave Email__SmtpHost empty to only write emails to /var/lib/sandugorea/outbox.
Email__SmtpHost=
Email__SmtpPort=587
Email__SmtpUser=hello@sandugorea.ch
Email__SmtpPassword=
Email__FromAddress=hello@sandugorea.ch
Email__FromName=Sandugorea Photography
Email__OwnerAddress=hello@sandugorea.ch

# 1 GB RAM server: process one photo at a time and cap image size
# (PNG files can't be decoded at reduced size, 60 MP = ~240 MB while processing).
Storage__ParallelProcessing=1
Storage__MaxMegapixels=60
