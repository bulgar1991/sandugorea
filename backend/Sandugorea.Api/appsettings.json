{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Storage": {
    "Root": "/var/lib/sandugorea",
    "MaxUploadBytes": 52428800,
    "MaxMegapixels": 120,
    "ParallelProcessing": 1
  },
  "Security": {
    "AdminMaxFailedAttempts": 5,
    "AdminLockoutMinutes": 15,
    "AdminIdleMinutes": 15,
    "CustomerMaxFailedAttempts": 10,
    "CustomerLockoutMinutes": 15,
    "CustomerSessionHours": 12,
    "TotpIssuer": "Sandugorea"
  },
  "Email": {
    "SmtpHost": "",
    "SmtpPort": 587,
    "FromAddress": "hello@sandugorea.ch",
    "FromName": "Sandugorea Photography",
    "OwnerAddress": "hello@sandugorea.ch"
  },
  "Site": {
    "BaseUrl": "https://sandugorea.ch"
  }
}
