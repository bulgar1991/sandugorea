{
  "name": "sandugorea-frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "lint": "ng lint --fix",
    "prettier": "npx prettier --write .",
    "test": "ng test",
    "test:watch": "ng test --watch",
    "icons:outline": "oslllo-svg-fixer -s src/assets/icons/src -d src/assets/icons/font-icons",
    "generate-fonts": "npm run icons:outline && fantasticon && node scripts/inline-icon-font.mjs && prettier --write src/app/models/icon-names.generated.ts"
  },
  "private": true,
  "packageManager": "npm@11.19.0",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@ngx-translate/core": "^18.1.0",
    "@ngx-translate/http-loader": "^18.1.0",
    "leaflet": "^1.9.4",
    "rxjs": "~7.8.0",
    "swiper": "^12.2.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-eslint/builder": "^22.6.0",
    "@angular-eslint/schematics": "^22.6.0",
    "@angular/build": "^22.2.4",
    "@angular/cli": "^22.2.4",
    "@angular/compiler-cli": "^22.2.0",
    "@eslint/js": "^10.0.1",
    "@types/leaflet": "^1.9.22",
    "@vitest/coverage-v8": "^5.1.0",
    "angular-eslint": "^22.6.0",
    "autoprefixer": "^10.6.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "fantasticon": "^3.0.0",
    "jsdom": "^30.1.3",
    "oslllo-svg-fixer": "^6.0.1",
    "postcss": "^8.5.32",
    "prettier": "^3.8.1",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "@parcel/watcher@2.6.0": true,
    "lmdb@3.5.6": true,
    "msgpackr-extract@3.0.6": true,
    "fsevents@2.3.3": true,
    "es5-ext": false,
    "ttf2woff2": false
  }
}
